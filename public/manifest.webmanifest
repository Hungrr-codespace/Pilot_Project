{
  "name": "Hungrr",
  "short_name": "Hungrr",
  "description": "Multiple restaurants, one delivery.",
  "start_url": "/?source=home-screen",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFDE21",
  "theme_color": "#FFDE21",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Order now", "url": "/pilot", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Track my order", "url": "/track", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My khata", "url": "/account", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
