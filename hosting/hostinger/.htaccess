# Hungrr on Hostinger, when you upload the built site yourself (File Manager → public_html).
# Not needed for a Hostinger "Node.js Web App" deployment: Hostinger writes its own .htaccess there.

# Every page address (/pilot, /track, /terms…) opens the React app; real files are served as they are.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Caching: the built scripts and styles have a fingerprint in their names, so browsers can keep them for a
# year. Images and fonts for a week. index.html is always checked, so visitors get a new version right away.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpe?g|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
